{
  "name": "impala67",
  "version": "2.2.86",
  "private": true,
  "description": "Impala67 - Local-First PWA Note-Taking App with E2EE Cloudflare Sync",
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8000 --directory web",
    "release": "node .github/scripts/release.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/sync-v4-browser.e2e.mjs",
    "test:all": "node --test test/*.test.mjs test/sync-v4-browser.e2e.mjs",
    "check:syntax": "node test/check-syntax.mjs",
    "check:pwa": "node .github/scripts/check-pwa-cache.mjs",
    "check:version": "node .github/scripts/check-version-sync.mjs",
    "verify": "npm test && npm run check:syntax && npm run check:pwa && npm run check:version && npm run check:core",
    "deploy": "wrangler deploy --config server/wrangler.toml",
    "dry-run": "wrangler deploy --config server/wrangler.toml --dry-run",
    "build:core": "node core/tools/build.mjs",
    "check:core": "node .github/scripts/check-core-build.mjs",
    "capacitor:copy:before": "node -e \"import('node:fs').then(fs=>fs.mkdirSync('.capacitor-disabled-stub',{recursive:true}))\"",
    "capacitor:sync:after": "node .github/scripts/build-android-rust.mjs"
  },
  "devDependencies": {
    "@capacitor-mlkit/document-scanner": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-speech-recognition": "^8.3.2",
    "@mindlib-capacitor/send-intent": "^8.0.6",
    "jsdom": "^30.1.2",
    "jsqr": "^1.4.0",
    "puppeteer-core": "^25.13.0",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
