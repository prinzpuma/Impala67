[
	{
		"type": "function",
		"function": {
			"name": "inspect",
			"description": "Liest App-Daten. Mehrere Seiten oder Karten in einem Aufruf abrufen.",
			"parameters": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"context",
							"pages",
							"page",
							"decks",
							"cards",
							"due",
							"search",
							"chats",
							"archived"
						],
						"description": "pages = Liste der Seiten & Hefte (optional query zum Filtern); page = Inhalt der Seiten/Hefte in 'titles' (inkl. OCR-Text & Seitenzahl bei Heften)"
					},
					"titles": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Seitentitel für kind=page"
					},
					"query": {
						"type": "string"
					},
					"deck": {
						"type": "string"
					},
					"limit": {
						"type": "number"
					},
					"semantic": {
						"type": "boolean",
						"description": "Semantische statt Stichwortsuche"
					}
				},
				"required": [
					"kind"
				]
			}
		}
	},
	{
		"type": "function",
		"function": {
			"name": "change",
			"description": "Führt mehrere Änderungen in einer atomaren, vollständig rückgängig machbaren Aktion aus. Reihenfolge der operations wird beachtet. Pflichtfelder: page.create title (+content, parent) · page.append/replace title+content · page.patch title+search+replace · page.rename title+to · page.move title+parent · page.trash/archive/unarchive title · heft.append title+text · card.create deck+cards · card.update front+new_front/new_back · card.move to+front/fronts/deck/query · card.trash/suspend front/fronts/deck/query · card.reset front · deck.create deck · deck.rename/move deck+to · deck.trash deck. Titel exakt aus inspect, nichts erfinden.",
			"parameters": {
				"type": "object",
				"properties": {
					"operations": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"op": {
									"type": "string",
									"enum": [
										"page.create",
										"page.append",
										"page.replace",
										"page.patch",
										"page.rename",
										"page.move",
										"page.trash",
										"page.archive",
										"page.unarchive",
										"heft.append",
										"card.create",
										"card.update",
										"card.move",
										"card.trash",
										"card.suspend",
										"card.reset",
										"deck.create",
										"deck.rename",
										"deck.move",
										"deck.trash"
									]
								},
								"title": {
									"type": "string"
								},
								"parent": {
									"type": "string",
									"description": "Exakter Titel des Zielordners."
								},
								"content": {
									"type": "string"
								},
								"text": {
									"type": "string"
								},
								"search": {
									"type": "string",
									"description": "Nur page.patch: exakter Text, der schon in der Seite steht."
								},
								"replace": {
									"type": "string",
									"description": "Nur page.patch: neuer Text."
								},
								"page": {
									"type": "number"
								},
								"front": {
									"type": "string"
								},
								"fronts": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"back": {
									"type": "string"
								},
								"new_front": {
									"type": "string"
								},
								"new_back": {
									"type": "string"
								},
								"cards": {
									"type": "array",
									"description": "Die Karten selbst (Pflicht bei card.create). Format: Vorderseite = konkrete Frage, Begriff oder Vokabel. Rückseite = präzise Kernantwort. LaTeX für Formeln. Eine Karte = ein Fakt.",
									"items": {
										"type": "object",
										"properties": {
											"front": {
												"type": "string"
											},
											"back": {
												"type": "string"
											}
										},
										"required": [
											"front",
											"back"
										]
									}
								},
								"deck": {
									"type": "string",
									"description": "Stapelname (Pflicht bei card.create)."
								},
								"to": {
									"type": "string",
									"description": "Neuer Name bzw. Zielstapel."
								},
								"query": {
									"type": "string"
								},
								"suspended": {
									"type": "boolean"
								},
								"limit": {
									"type": "number",
									"description": "Nur card.move/trash/suspend."
								}
							},
							"required": [
								"op"
							]
						},
						"minItems": 1
					}
				},
				"required": [
					"operations"
				]
			}
		}
	},
